PORT=3001
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Set to true in production — scraper must run headless on a server (no display)
SCRAPER_HEADLESS=true

# Optional: number of retries per product (default: 2)
MAX_PRODUCT_RETRIES=2

# Required in production: protects POST /api/jobs/run-scraper from unauthorized access.
# Used by cron-job.org (and manual curl) via the X-Cron-Secret HTTP header.
# Generate a strong random value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value.
CRON_SECRET=replace-with-a-strong-random-secret


